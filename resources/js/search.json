ac-address sticky"]},{"i":"port-sicherheit-sticky-flag-1-code-2","c":["Sx(config-if-range)# switchport port-security maximum xx"]},{"i":"einen-trunk-link-zu-weisen-1","l":"einen Trunk Link zu weisen"},{"i":"einen-trunk-link-zu-weisen-1-code-1","c":["Sx(config-if)# switchport mode trunk"]},{"i":"trunk-link-zum-native-vlan-erklären-1","l":"Trunk Link zum Native VLAN erklären"},{"i":"trunk-link-zum-native-vlan-erklären-1-code-1","c":["Sx(config-if)# switchport trunk native vlan xx"]},{"i":"nur-die-vorhandenen-vlans-zulassen-1","l":"Nur die vorhandenen VLANs zulassen"},{"i":"nur-die-vorhandenen-vlans-zulassen-1-code-1","c":["Sx(config-if)# switchport trunk allowed vlan xx, xx, xx, ..."]},{"i":"protokoll-dot1q-aktivieren-gilt-nur-für-switch-3560-1","l":"Protokoll dot1q aktivieren (gilt nur für Switch 3560!)"},{"i":"protokoll-dot1q-aktivieren-gilt-nur-für-switch-3560-1-code-1","c":["Sx(config-if)# switchport trunk encapsulation dot1q"]},{"l":"Schnittstellenkonfiguration vom VLANs"},{"i":"entering-4","l":"Entering"},{"i":"entering-4-code-1","c":["Sx (config)# interface vlan xx"]},{"i":"exiting-5","l":"Exiting"},{"i":"exiting-5-code-1","c":["Sx (config-if)# exit"]},{"l":"Ip Adresse einstellen"},{"i":"ip-adresse-einstellen-code-1","c":["Sx (config-if)# ip address xxx.xxx.xxx.xxx xxx.xxx.xxx.xxx"]},{"l":"Schnittstelle aktivieren"},{"i":"schnittstelle-aktivieren-code-1","c":["Sx (config-if)# no shutdown"]},{"l":"VLAN-Konfigurationsmodus"},{"i":"entering-5","l":"Entering"},{"i":"entering-5-code-1","c":["Sx (config)# vlan xx\nSx (config-vlan)#"]},{"i":"exiting-6","l":"Exiting"},{"i":"exiting-6-code-1","c":["Sx (config-if)# exit"]},{"l":"Namen für das VLAN vergeben"},{"i":"namen-für-das-vlan-vergeben-code-1","c":["Sx (config-vlan)# name xxxxxxxxxxxxxx"]}],[],[{"l":"DSL Explanitys"},{"l":"Technik beim Kunden"}],[],[],[{"i":"#","p":["Grundlagen für die Programmiersprache Java"]},{"l":"Java Grundlagen"},{"l":"Klassen"},{"i":"klassen-code-1","c":["public class Klassenname {\n    //some code\n    // Attribute\n    // Methoden\n}"]},{"l":"Methoden"},{"l":"Wertrückgabe"},{"i":"wertrückgabe-code-1","c":["public Datentyp methodenname(Datentyp parametername, ...) {\n    //some code\n    return Wert;\n}"]},{"l":"Wertrückgabe per Variable"},{"i":"wertrückgabe-per-variable-code-1","c":["public Datentyp methodenname(Datentyp parametername, ...) {\n    //some code\n    return variable;\n}"]},{"l":"Keine Wertrückgabe"},{"i":"keine-wertrückgabe-code-1","c":["public void methodenname(Datentyp parametername, ...) {\n    //some code\n}"]},{"l":"Methodenaufruf aus Testklasse"},{"i":"methodenaufruf-aus-testklasse-code-1","c":["methodenname(parametername, ...);"]},{"l":"Methodenaufruf aus Objektklasse"},{"i":"methodenaufruf-aus-objektklasse-code-1","c":["Objektname.methodenname(parametername, ...);"]},{"l":"Methodenaufruf in Objektklasse"},{"i":"methodenaufruf-in-objektklasse-code-1","c":["this.methodenname(parametername, ...);"]},{"l":"Variablen"},{"l":"Ohne Initialisierung"},{"i":"ohne-initialisierung-code-1","c":["Datentyp variablenname;"]},{"l":"Mit Initialisierung"},{"i":"mit-initialisierung-code-1","c":["Datentyp variablenname = Wert;"]},{"l":"per Bedingung"},{"i":"per-bedingung-code-1","c":["Datentyp variablenname = Bedingung ? Wert_bei_true : Wert_bei_false"]},{"l":"Wertzuweisung einer Variable aus Testklasse"},{"i":"wertzuweisung-einer-variable-aus-testklasse-code-1","c":["variablenname = Wert;"]},{"l":"Konstante"},{"i":"konstante-code-1","c":["final Datentyp variablenname = Wert;"]},{"l":"Array"},{"i":"array-code-1","c":["Datentyp[] variablenname = new Datentyp[Anzahl];"]},{"l":"Array mit Initialisierung"},{"i":"array-mit-initialisierung-code-1","c":["Datentyp[] variablenname = {Wert1, Wert2, ...};"]},{"l":"Wertzuweisung eines Array-Elements aus Testklasse"},{"i":"wertzuweisung-eines-array-elements-aus-testklasse-code-1","c":["variablenname[Arrayindex] = Wert;"]},{"l":"Wertzuweisung einer Variable eines Objekts aus Testklasse"},{"i":"wertzuweisung-einer-variable-eines-objekts-aus-testklasse-code-1","c":["Objektname.variablenname = Wert;"]},{"l":"Wertzuweisung eines Array-Elements eines Objekts"},{"i":"wertzuweisung-eines-array-elements-eines-objekts-code-1","c":["Objektname.variablenname[Arrayindex] = Wert;"]},{"l":"Wertzuweisung einer Variable in Objektklasse"},{"i":"wertzuweisung-einer-variable-in-objektklasse-code-1","c":["this.variablenname = Wert;"]},{"l":"Wertzuweisung einer Variable eines Array-Objektes"},{"i":"wertzuweisung-einer-variable-eines-array-objektes-code-1","c":["Objektname[Arrayindex].variablenname = Wert;"]},{"l":"Wertzuweisung eines Array-Elements eines Array-Objektes"},{"i":"wertzuweisung-eines-array-elements-eines-array-objektes-code-1","c":["Objektname[Arrayindex].variablenname[Arrayindex] = Wert;"]},{"l":"Wertzuweisung eines Array-Elements in Objektklasse"},{"i":"wertzuweisung-eines-array-elements-in-objektklasse-code-1","c":["this.variablenname[Arrayindex] = Wert;"]},{"l":"ArrayLists"},{"l":"ArrayLists importieren"},{"i":"arraylists-importieren-code-1","c":["import java.util.ArrayList;"]},{"l":"ArrayList erstellen"},{"i":"arraylist-erstellen-code-1","c":["ArrayList<Datentyp> variablenname = new ArrayList<>();"]},{"i":"arraylist-erstellen-code-2","c":["ArrayList<Datentyp> variablenname = new ArrayList<Datentyp>();"]},{"l":"ArrayList mit Initialisierung"},{"i":"arraylist-mit-initialisierung-code-1","c":["ArrayList<Datentyp> variablenname = new ArrayList<>(List.of(Wert1, Wert2, ...));"]},{"l":"Element zur ArrayList hinzufügen"},{"i":"element-zur-arraylist-hinzufügen-code-1","c":["variablenname.add(Wert);"]},{"l":"Element in der ArrayList ändern"},{"i":"element-in-der-arraylist-ändern-code-1","c":["variablenname.set(Index, Wert);"]},{"l":"Element aus der ArrayList entfernen"},{"i":"element-aus-der-arraylist-entfernen-code-1","c":["variablenname.remove(Index);"]},{"l":"Element aus der ArrayList abrufen"},{"i":"element-aus-der-arraylist-abrufen-code-1","c":["Datentyp element = variablenname.get(Index);"]},{"l":"ArrayList-Größe abrufen"},{"i":"arraylist-größe-abrufen-code-1","c":["int size = variablenname.size();"]},{"l":"Überprüfen, ob die ArrayList leer ist"},{"i":"überprüfen-ob-die-arraylist-leer-ist-code-1","c":["boolean isEmpty = variablenname.isEmpty();"]},{"l":"ArrayList leeren"},{"i":"arraylist-leeren-code-1","c":["variablenname.clear();"]},{"l":"Überprüfen, ob ein Element in der ArrayList enthalten ist"},{"i":"überprüfen-ob-ein-element-in-der-arraylist-enthalten-ist-code-1","c":["boolean contains = variablenname.contains(Wert);"]},{"l":"Konstruktoren"},{"l":"Normal"},{"i":"normal-code-1","c":["Klassenname variablenname = new Klassenname(parametername, ...);"]},{"i":"array-1","l":"Array"},{"i":"array-1-code-1","c":["Datentyp[] variablenname = new Datentyp[Anzahl];\n\nfor (int i = 0; i < Anzahl; i++) {\n    variablenname[i] = new Datentyp(parametername, ...);\n}"]},{"l":"in Objectklasse"},{"i":"in-objectklasse-code-1","c":["public Klassenname {\n\n    klassenname(Datentyp parametername, ...) {\n        //some code\n    }\n}"]},{"l":"Kontrollstrukturen / Schleifen"},{"l":"if"},{"i":"if-code-1","c":["if (Bedingung) {\n    //some code\n}"]},{"l":"if else"},{"i":"if-else-code-1","c":["if (Bedingung) {\n    //some code\n} else {\n    //some code\n}"]},{"l":"if else if"},{"i":"if-else-if-code-1","c":["if (Bedingung) {\n    //some code\n} else if (Bedingung) {\n    //some code\n} else {\n    //some code\n}"]},{"l":"switch (case)"},{"i":"switch-case-code-1","c":["switch (Variable) {\n    case Wert1:\n        //some code\n        break;\n    case Wert2:\n        //some code\n        break;\n    default:\n        //some code\n}"]},{"l":"while"},{"i":"while-code-1","c":["while (Bedingung) {\n    //some code\n}"]},{"l":"do while"},{"i":"do-while-code-1","c":["do {\n    //some code\n} while (Bedingung);"]},{"l":"for"},{"i":"for-code-1","c":["for (int i = 0; i < Anzahl; i++) {\n    //some code\n}"]},{"l":"for each"},{"i":"for-each-code-1","c":["for (Datentyp variablenname : Array) {\n    //some code\n}"]},{"l":"Konsole"},{"l":"Ausgabe"},{"i":"ausgabe-code-1","c":["System.out.println(\"Text\");"]},{"l":"Eingabe"},{"i":"eingabe-code-1","c":["import java.util.Scanner;\n\nKlassenname {\n        Scanner scanner = new Scanner(System.in);\n        String eingabe = scanner.next();\n        String eingabe = scanner.nextLine();\n        int eingabe = scanner.nextInt();\n        double eingabe = scanner.nextDouble();\n        char eingabe = scanner.next().charAt(0);\n}"]},{"l":"Kommandozeilenargumente in Java"},{"l":"Syntax"},{"i":"syntax-code-1","c":["public class MeineKlasse {\n    public static void main(String[] args) {\n        // Code zur Verwendung der Kommandozeilenargumente\n    }\n}"]},{"l":"Beschreibung","p":["Kommandozeilenargumente ermöglichen es, Werte an ein Java-Programm zu übergeben, wenn es gestartet wird. Die Argumente werden in Form von Zeichenketten (Strings) übergeben und stehen in der main-Methode des Programms als Array args zur Verfügung."]},{"l":"Verwendung","p":["Um das Java-Programm mit Kommandozeilenargumenten auszuführen, geben Sie diese nach dem Befehl java gefolgt vom Klassennamen an. Die Argumente werden durch Leerzeichen getrennt.","In der main-Methode des Java-Programms können die übergebenen Argumente im Array args verarbeitet werden. Hier ein Beispiel, wie man alle übergebenen Argumente ausgibt:"]},{"i":"verwendung-code-1","c":["java MeineKlasse argument1 argument2 argument3 ..."]},{"i":"verwendung-code-2","c":["java -jar MeinProgramm.jar argument1 argument2 argument3 ..."]},{"i":"verwendung-code-3","c":["public class MeineKlasse {\n    public static void main(String[] args) {\n        // Ausgabe aller übergebenen Argumente\n        for (int i = 0; i < args.length; i++) {\n            System.out.println(\"Argument \" + i + \": \" + args[i]);\n        }\n    }\n}"]},{"i":"verwendung-code-4","c":["public class MeinProgramm {\n    public static void main(String[] args) {\n            // Ausgabe der übergebenen Argumente mit einer Foreach-Schleife\n            System.out.println(\"Übergebene Argumente:\");\n            int index = 0;\n            for (String arg : args) {\n                System.out.println(\"Argument \" + index + \": \" + arg);\n                index++;\n            }\n        }\n    }"]},{"l":"Hinweis","p":["Kommandozeilenargumente werden immer als Zeichenketten (Strings) übergeben. Wenn andere Datentypen benötigt werden, müssen sie entsprechend geparst oder konvertiert werden.","Wenn keine Argumente übergeben werden, ist das args-Array leer (mit der Länge 0). In diesem Fall wird die for-Schleife bzw. foreach-Schleife nicht ausgeführt und es erfolgt keine Ausgabe."]}],[],[],[{"i":"#","p":["Grundlagen für SQL(MySQL)"]},{"l":"SQL (MySQL) Grundlagen"},{"l":"1. Datenbank und Tabelle erstellen:"},{"i":"1-datenbank-und-tabelle-erstellen-code-1","c":["-- Datenbank erstellen\nCREATE DATABASE IF NOT EXISTS meine_datenbank;\n\n-- Tabelle erstellen\nUSE meine_datenbank;\nCREATE TABLE IF NOT EXISTS meine_tabelle (\n    id INT PRIMARY KEY,\n    name VARCHAR(255),\n    alter INT\n);"]},{"l":"2. Datensatz einfügen:"},{"i":"2-datensatz-einfügen-code-1","c":["INSERT INTO meine_tabelle (id, name, alter)\nVALUES (1, 'Max Mustermann', 30);"]},{"l":"3. Daten abfragen:"},{"i":"3-daten-abfragen-code-1","c":["SELECT * FROM meine_tabelle;"]},{"l":"4. Bedingte Abfrage (WHERE-Klausel):"},{"i":"4-bedingte-abfrage-where-klausel-code-1","c":["SELECT * FROM meine_tabelle WHERE alter > 25;"]},{"l":"5. Daten aktualisieren:"},{"i":"5-daten-aktualisieren-code-1","c":["UPDATE meine_tabelle SET alter = 31 WHERE id = 1;"]},{"l":"6. Daten löschen:"},{"i":"6-daten-löschen-code-1","c":["DELETE FROM meine_tabelle WHERE id = 1;"]},{"l":"7. Join (INNER JOIN):"},{"i":"7-join-inner-join-code-1","c":["SELECT t1.id, t1.name, t2.adresse\nFROM tabelle1 t1\nINNER JOIN tabelle2 t2 ON t1.id = t2.id;"]},{"l":"8. Join (LEFT JOIN):"},{"i":"8-join-left-join-code-1","c":["SELECT t1.id, t1.name, t2.adresse\nFROM tabelle1 t1\nLEFT JOIN tabelle2 t2 ON t1.id = t2.id;"]},{"l":"9. Unterabfrage (Subquery):"},{"i":"9-unterabfrage-subquery-code-1","c":["SELECT spalte1, spalte2\nFROM tabelle1\nWHERE spalte1 IN (SELECT spalte1 FROM tabelle2);"]},{"l":"10. Aggregatfunktion (COUNT):"},{"i":"10-aggregatfunktion-count-code-1","c":["SELECT COUNT(*) FROM meine_tabelle;"]},{"l":"11. Transaktionen:"},{"i":"11-transaktionen-code-1","c":["-- Transaktion starten\nSTART TRANSACTION;\n\n-- SQL-Befehle hier ausführen\n\n-- Transaktion beenden (Commit)\nCOMMIT;\n\n-- Transaktion rückgängig machen (Rollback)\nROLLBACK;"]},{"l":"12. Index erstellen:"},{"i":"12-index-erstellen-code-1","c":["CREATE INDEX index_name ON meine_tabelle(spalte);"]},{"l":"13. Datenbank löschen:"},{"i":"13-datenbank-löschen-code-1","c":["-- Datenbank löschen\nDROP DATABASE IF EXISTS meine_datenbank;"]},{"l":"14. Tabelle löschen:"},{"i":"14-tabelle-löschen-code-1","c":["-- Tabelle löschen\nDROP TABLE IF EXISTS meine_tabelle;"]},{"l":"15. Bedingte Abfrage (AND, OR):"},{"i":"15-bedingte-abfrage-and-or-code-1","c":["SELECT * FROM meine_tabelle WHERE alter > 25 AND geschlecht = 'weiblich';\nSELECT * FROM meine_tabelle WHERE ort = 'Berlin' OR ort = 'Hamburg';"]},{"l":"16. Bedingte Abfrage (LIKE):"},{"i":"16-bedingte-abfrage-like-code-1","c":["-- Alle Namen, die mit \"M\" beginnen\nSELECT * FROM meine_tabelle WHERE name LIKE 'M%';\n\n-- Alle Namen, die \"e\" als dritten Buchstaben haben\nSELECT * FROM meine_tabelle WHERE name LIKE '__e%';"]},{"l":"17. Sortieren (ORDER BY):"},{"i":"17-sortieren-order-by-code-1","c":["-- Aufsteigend nach Alter sortieren\nSELECT * FROM meine_tabelle ORDER BY alter ASC;\n\n-- Absteigend nach Namen sortieren\nSELECT * FROM meine_tabelle ORDER BY name DESC;"]},{"l":"18. Datensätze gruppieren (GROUP BY):"},{"i":"18-datensätze-gruppieren-group-by-code-1","c":["-- Anzahl der Personen pro Ort ermitteln\nSELECT ort, COUNT(*) as anzahl_personen FROM meine_tabelle GROUP BY ort;"]},{"l":"19. Aggregatfunktionen (SUM, AVG, MIN, MAX):"},{"i":"19-aggregatfunktionen-sum-avg-min-max-code-1","c":["-- Summe der Gehälter berechnen\nSELECT SUM(gehalt) FROM mitarbeiter;\n\n-- Durchschnittsalter berechnen\nSELECT AVG(alter) FROM meine_tabelle;\n\n-- Älteste Person finden\nSELECT MAX(alter) FROM meine_tabelle;"]},{"l":"20. Daten aktualisieren (CASE-Anweisung):"},{"i":"20-daten-aktualisieren-case-anweisung-code-1","c":["-- Alter basierend auf einer Bedingung aktualisieren\nUPDATE meine_tabelle\nSET alter = CASE\n    WHEN geschlecht = 'weiblich' THEN alter + 1\n    ELSE alter\nEND;"]},{"l":"21. Benutzer und Berechtigungen erstellen (für Administratoren):"},{"i":"21-benutzer-und-berechtigungen-erstellen-für-administratoren-code-1","c":["-- Benutzer erstellen\nCREATE USER 'neuer_benutzer'@'localhost' IDENTIFIED BY 'passwort';\n\n-- Berechtigungen zuweisen\nGRANT SELECT, INSERT, UPDATE ON meine_datenbank.meine_tabelle TO 'neuer_benutzer'@'localhost';\n\n-- Berechtigungen widerrufen\nREVOKE INSERT ON meine_datenbank.meine_tabelle FROM 'neuer_benutzer'@'localhost';\n\n-- Benutzer löschen\nDROP USER 'neuer_benutzer'@'localhost';"]},{"l":"22. Datenbankverbindung herstellen:"},{"i":"22-datenbankverbindung-herstellen-code-1","c":["-- Verbindung zur Datenbank herstellen\nmysql -u benutzername -p passwort -h host -D datenbankname"]},{"l":"23. Zeichenkodierung festlegen:"},{"i":"23-zeichenkodierung-festlegen-code-1","c":["-- Zeichenkodierung in der Datenbank setzen\nALTER DATABASE meine_datenbank CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;\n\n-- Zeichenkodierung in der Tabelle setzen\nALTER TABLE meine_tabelle CONVERT TO CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"]},{"l":"24. Sichere Passwörter verwenden:"},{"i":"24-sichere-passwörter-verwenden-code-1","c":["-- Ein sicheres Passwort setzen\nALTER USER 'benutzer'@'localhost' IDENTIFIED WITH mysql_native_password BY 'sicheres_passwort';"]},{"l":"25. Backups erstellen und wiederherstellen:"},{"i":"25-backups-erstellen-und-wiederherstellen-code-1","c":["-- Backup erstellen\nmysqldump -u benutzername -p passwort meine_datenbank > backup.sql\n\n-- Datenbank wiederherstellen\nmysql -u benutzername -p passwort meine_datenbank < backup.sql"]},{"l":"26. Indizes richtig verwenden:"},{"i":"26-indizes-richtig-verwenden-code-1","c":["-- Indexe anlegen\nCREATE INDEX index_name ON meine_tabelle(spalte);\n\n-- Indexe entfernen\nDROP INDEX index_name ON meine_tabelle;"]},{"l":"27. Views erstellen:"},{"i":"27-views-erstellen-code-1","c":["-- View erstellen\nCREATE VIEW mein_view AS\nSELECT spalte1, spalte2 FROM meine_tabelle WHERE bedingung;\n\n-- View aktualisieren\nCREATE OR REPLACE VIEW mein_view AS\nSELECT spalte1, spalte2 FROM meine_tabelle WHERE bedingung;"]},{"l":"28. Trigger definieren:"},{"i":"28-trigger-definieren-code-1","c":["-- Trigger erstellen\nDELIMITER //\nCREATE TRIGGER mein_trigger BEFORE INSERT ON meine_tabelle\nFOR EACH ROW\nBEGIN\n    -- Trigger-Code hier\nEND;\n//\n\n-- Trigger entfernen\nDROP TRIGGER IF EXISTS mein_trigger;"]},{"l":"29. Datenbankrechte verwalten:"},{"i":"29-datenbankrechte-verwalten-code-1","c":["-- Berechtigungen zuweisen\nGRANT SELECT, INSERT ON meine_datenbank.meine_tabelle TO 'benutzer'@'localhost';\n\n-- Berechtigungen widerrufen\nREVOKE INSERT ON meine_datenbank.meine_tabelle FROM 'benutzer'@'localhost';"]},{"l":"30. Fehlerbehandlung mit Stored Procedures:"},{"i":"30-fehlerbehandlung-mit-stored-procedures-code-1","c":["-- Stored Procedure erstellen\nDELIMITER //\nCREATE PROCEDURE meine_prozedur()\nBEGIN\n    -- Prozedur-Code hier\nEND;\n//\n\n-- Stored Procedure aufrufen\nCALL meine_prozedur();"]},{"l":"31. Verwendung der IN-Klausel:"},{"l":"Abfrage nach bestimmten IDs:"},{"i":"abfrage-nach-bestimmten-ids-code-1","c":["SELECT * FROM meine_tabelle WHERE id IN (1, 3, 5);"]},{"l":"Abfrage mit einer Unterabfrage:"},{"i":"abfrage-mit-einer-unterabfrage-code-1","c":["SELECT * FROM meine_tabelle WHERE id IN (SELECT id FROM andere_tabelle WHERE bedingung);"]},{"l":"Verwendung mit Zeichenketten:"},{"i":"verwendung-mit-zeichenketten-code-1","c":["SELECT * FROM meine_tabelle WHERE name IN ('Max', 'Anna', 'Peter');"]},{"l":"Verwendung mit Subquery und NOT IN:"},{"i":"verwendung-mit-subquery-und-not-in-code-1","c":["SELECT * FROM meine_tabelle WHERE id NOT IN (SELECT id FROM andere_tabelle WHERE bedingung);"]},{"l":"32. Datentypen","p":["-1.7976931348623158e+308","-1038 to 1038","-128","\"1234567890\"","\"männlich\", \"weiblich\"","\"männlich\", \"weiblich\", \"divers\"","\"Max Mustermann\"","\"Musterbeschreibung\"","\"Musterfoto.jpg\"","\"Musterstadt\"","\"Musterstraße 1\"","1 Byte","1 Byte to 255 Byte","1 Byte to 4294967295 Byte","1 Byte to 64 Byte","1 Byte to 65535 Byte","1.1754943508222875e-38 to","1.7976931348623158e+308 to","12:00:00","123.456.789","127","14.142.135.623.730.900","16777215","18446744073709551615","2 Byte","2023-07-20","2023-07-20 12:00:00","2147483647","255","3 Byte","3.4028234663852886e+38","314.159","32767","4 Byte","4294967295","65535","8 Byte","9223372036854775807","Beispiel","BIGINT","BINARY","BLOB","CHAR","DATE","Datentyp","DATETIME","DECIMAL","DOUBLE","ENUM","FLOAT","HH:MM:SS","INT","Maximale Größe","MEDIUMINT","Minimale Größe","SET","SMALLINT","TEXT","TIME","TIMESTAMP","TINYINT","VARBINARY","VARCHAR","YYYY-MM-DD","YYYY-MM-DD HH:MM:SS"]}],[{"i":"#","p":["Grundlagen für die Verbindung von Java mit SQL(MySQL)"]},{"l":"Using SQL in Java"},{"l":"1. MySQL Connector/J herunterladen:","p":["Zuerst müssen Sie den MySQL Connector/J JDBC-Treiber herunterladen und in Ihrem Projekt einbinden. Sie können es von der offiziellen MySQL-Website herunterladen."]},{"l":"2. Projekt einrichten:","p":["Erstellen Sie ein neues Java-Projekt in Ihrer bevorzugten Entwicklungsumgebung und fügen Sie den heruntergeladenen JDBC-Treiber zu den externen Bibliotheken hinzu."]},{"l":"3. Datenbankverbindung herstellen:","p":["Verwenden Sie die java.sql.Connection-Schnittstelle, um eine Verbindung zur MySQL-Datenbank herzustellen. Geben Sie dabei die Datenbank-URL, den Benutzernamen und das Passwort an."]},{"i":"3-datenbankverbindung-herstellen-code-1","c":["import java.sql.Connection;\nimport java.sql.DriverManager;\nimport java.sql.SQLException;\n\npublic class DatabaseConnector {\n    private static final String JDBC_URL = \"jdbc:mysql://localhost:3306/deineDatenbank\";\n    private static final String USER = \"deinBenutzername\";\n    private static final String PASSWORD = \"deinPasswort\";\n\n    public static Connection connect() throws SQLException {\n        return DriverManager.getConnection(JDBC_URL, USER, PASSWORD);\n    }\n}"]},{"l":"4. SQL-Abfragen ausführen:","p":["Nutzen Sie die java.sql.Statement-Schnittstelle, um SQL-Abfragen auszuführen. Hier ist ein einfaches Beispiel zum Abrufen von Daten:"]},{"i":"4-sql-abfragen-ausführen-code-1","c":["import java.sql.Connection;\nimport java.sql.ResultSet;\nimport java.sql.SQLException;\nimport java.sql.Statement;\n\npublic class Main {\n    public static void main(String[] args) {\n        try {\n            Connection connection = DatabaseConnector.connect();\n            Statement statement = connection.createStatement();\n\n            String query = \"SELECT * FROM deineTabelle\";\n            ResultSet resultSet = statement.executeQuery(query);\n\n            while (resultSet.next()) {\n                // Verarbeite die Ergebnisse hier\n                System.out.println(resultSet.getString(\"spaltenName\"));\n            }\n\n            // Aufräumen\n            resultSet.close();\n            statement.close();\n            connection.close();\n        } catch (SQLException e) {\n            e.printStackTrace();\n        }\n    }\n}"]}],[],[]]